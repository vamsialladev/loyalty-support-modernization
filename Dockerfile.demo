# The public demo in one image (spec L1; SEC-18; ADR-0087): app, worker and mock customer API, started together by
# `python -m app.demo_launch`, for a host with one free web service (Render, option A). The synthetic world is
# generated at build time and only its operational files are copied in: no labels, no generator, no benchmark data.
# Every other deployment uses Dockerfile.app and mock_customer_api/Dockerfile as separate services (TD-56).
FROM ghcr.io/astral-sh/uv:0.13.5 AS uv

FROM python:3.12.16-slim-bookworm AS base
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PATH=/opt/venv/bin:$PATH
WORKDIR /srv
# Debian's security updates at build time, as in the other images (ADR-0084).
RUN apt-get update && apt-get upgrade -y --no-install-recommends && rm -rf /var/lib/apt/lists/* \
    && useradd --uid 10001 --no-create-home --shell /usr/sbin/nologin svc

FROM base AS deps
COPY --from=uv /uv /bin/uv
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy UV_PROJECT_ENVIRONMENT=/opt/venv
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-default-groups --group api --no-install-project

# The synthetic world, made here and left here except for the operational files the mock API serves. Its own
# environment, with the generator's extra libraries (the `data` group), which the final image doesn't carry.
FROM base AS world
COPY --from=uv /uv /bin/uv
ENV UV_COMPILE_BYTECODE=0 UV_LINK_MODE=copy UV_PROJECT_ENVIRONMENT=/opt/world PATH=/opt/world/bin:$PATH
COPY pyproject.toml uv.lock /build/
WORKDIR /build
RUN uv sync --frozen --no-default-groups --group api --group data --no-install-project
COPY . /build
RUN python -m seed_data.generator generate

FROM base AS demo
COPY --from=deps /opt/venv /opt/venv
COPY alembic.ini ./
COPY migrations ./migrations
COPY app ./app
COPY config ./config
COPY policies ./policies
COPY customer_shapes ./customer_shapes
COPY mock_customer_api ./mock_customer_api
COPY --from=world /build/seed_data/v1 ./seed_data/v1
# The mock API loads its world from here. The app code never names the folder; a guard test checks that.
ENV MOCK_API_SEED_DIR=/srv/seed_data/v1
USER 10001
EXPOSE 8010
HEALTHCHECK --interval=30s --timeout=10s --start-period=180s --retries=3 \
  CMD ["python", "-c", "import os, urllib.request; urllib.request.urlopen('http://localhost:' + os.environ.get('PORT', '8010') + '/healthz', timeout=5)"]
CMD ["python", "-m", "app.demo_launch"]
