{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.development)",
      "Read(./.env.staging)",
      "Read(./.env.production)",
      "Read(./.env.test)",
      "Read(./**/.env)",
      "Read(./secrets/**)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Edit(./.env)",
      "Bash(cat .env)",
      "Bash(cat ./.env)",
      "Bash(type .env)",
      "Bash(Get-Content .env)",
      "Bash(more .env)",
      "Bash(less .env)",
      "Bash(head .env)",
      "Bash(tail .env)"
    ]
  }
}
