# Local (a laptop): synthetic data, mock AI, local Postgres in Compose (spec F.2; DEL-05, ADR-0075).
# Non-secret settings only. Secrets come from your own .env (scripts\update-local-env.ps1 generates them), never here.
# Check with:  uv run python -m app.preflight --profile portfolio
APP_PROFILE=portfolio
LOG_LEVEL=INFO
PUBLIC_DEMO_MODE=false
AI_PROVIDER=mock
FEATURE_LIVE_AI=false
FEATURE_ADJUSTMENT_EXECUTION=true
FEATURE_PROTOCOL_LABS=false
FEATURE_MCP=false
FEATURE_A2A=false
FEATURE_AG_UI=false
AUTH_MODE=local
MOCK_API_FAULTS=false
MOCK_API_SIM_CLOCK=false
MOCK_API_URL=http://mock-api:8020
APP_BASE_URL=http://127.0.0.1:8010
LLM_BUDGET_USD_PER_RUN=1.00
LLM_BUDGET_USD_TOTAL=5.00
