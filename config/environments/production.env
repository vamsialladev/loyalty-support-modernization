# Production (the "approved" deployment profile): enterprise sign-in, managed database, no demo accounts, no debug
# (spec F.2, C.10; DEL-05, ADR-0075). Non-secret settings only: every secret lives in the platform's secret store.
# Not deployed anywhere: production needs the release gates in docs/release-gates.md and the owner's approval.
# Check a candidate configuration with:  uv run python -m app.preflight --profile approved
APP_PROFILE=approved
LOG_LEVEL=INFO
PUBLIC_DEMO_MODE=false
AI_PROVIDER=mock
FEATURE_LIVE_AI=false
FEATURE_ADJUSTMENT_EXECUTION=false
FEATURE_PROTOCOL_LABS=false
FEATURE_MCP=false
FEATURE_A2A=false
FEATURE_AG_UI=false
AUTH_MODE=oidc
MOCK_API_FAULTS=false
MOCK_API_SIM_CLOCK=false
LLM_BUDGET_USD_PER_RUN=1.00
LLM_BUDGET_USD_TOTAL=5.00
