# =====================================================================
# AI Loyalty Support Modernization Platform: environment template
# ---------------------------------------------------------------------
# 1. Copy to .env           (cp .env.example .env)
# 2. Fill in ONLY what you have. Leave the rest empty.
#    Empty = that feature runs in mock/offline mode or is marked Blocked.
# 3. NEVER commit .env, never paste its values into chat, never put
#    passwords here. Use scoped API tokens only.
# 4. Variable names marked (verify) must be checked against the
#    vendor's current official docs by Claude Code before use.
# =====================================================================

# ---------- Core profile ---------------------------------------------
APP_PROFILE=portfolio            # portfolio | discovery | staging | approved
APP_SECRET_KEY=                  # generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
PUBLIC_DEMO_MODE=false

# ---------- Local database (Docker Compose, no account needed) --------
# One Postgres server, three roles (ADR-0036): POSTGRES_USER is the admin; the app and the mock API each have
# their own login role and database, and the app's role cannot connect to the mock API's database.
POSTGRES_USER=loyalty
POSTGRES_PASSWORD=               # admin password, any local dev value
POSTGRES_DB=loyalty
APP_DB_PASSWORD=                 # role loyalty_app, any local dev value
MOCK_API_DB_PASSWORD=            # role mock_api, any local dev value
DATABASE_URL=postgresql+psycopg://loyalty_app:${APP_DB_PASSWORD}@localhost:5432/loyalty
MOCK_API_DATABASE_URL=postgresql+psycopg://mock_api:${MOCK_API_DB_PASSWORD}@localhost:5432/mock_customer_api
MOCK_API_TOKEN=                  # any local dev value, used app -> mock API (and for its control endpoints)
MOCK_API_URL=http://localhost:8020
MOCK_API_FAULTS=false            # true enables X-Mock-Fault and seeded fault rules (tests and benchmark only)
MOCK_API_SIM_CLOCK=false         # true enables X-Sim-Time (benchmark only; never in a hosted demo)

# ---------- Runtime AI: Claude API (optional; mock if empty) ----------
AI_PROVIDER=mock                 # mock | anthropic | bedrock | moonshot | zai | dashscope
ANTHROPIC_API_KEY=               # console.anthropic.com; also set a spend limit there
ANTHROPIC_MODEL=                 # exact model ID, chosen from current docs
LLM_BUDGET_USD_PER_RUN=1.00
LLM_BUDGET_USD_TOTAL=5.00

# ---------- Enterprise path: Claude via Amazon Bedrock (optional) -----
AWS_PROFILE=                     # use `aws configure sso`; NO long-lived access keys here
AWS_REGION=
BEDROCK_MODEL_ID=                # (verify)

# ---------- Alternative models (optional, one at a time) --------------
MOONSHOT_API_KEY=                # Kimi (verify)
ZAI_API_KEY=                     # GLM (verify)
DASHSCOPE_API_KEY=               # Qwen via Alibaba Cloud (verify)
# Self-hosted alternative instead of keys:
LOCAL_MODEL_BASE_URL=            # e.g. a local OpenAI-compatible server

# ---------- Enterprise identity demo (local Keycloak, no account) -----
OIDC_ISSUER_URL=http://localhost:8081/realms/loyalty
OIDC_CLIENT_ID=loyalty-console
OIDC_CLIENT_SECRET=              # generated by the local Keycloak setup script
KEYCLOAK_ADMIN_PASSWORD=         # local dev value only

# ---------- Supabase (optional hosted/local profile) ------------------
SUPABASE_URL=                    # (verify key names: Supabase has newer publishable/secret keys)
SUPABASE_PUBLISHABLE_KEY=        # browser-safe
SUPABASE_SECRET_KEY=             # SERVER ONLY, never in frontend
SUPABASE_DB_URL=

# ---------- GitHub / CI / CodeRabbit ----------------------------------
GH_TOKEN=                        # fine-grained token, THIS repo only, minimal scopes
# CodeRabbit: no key. Install the GitHub app on this single repo via its website.

# ---------- Vercel (React frontend deploy, only when authorized) ------
VERCEL_TOKEN=                    # scoped token (verify)
VERCEL_PROJECT_ID=
VERCEL_ORG_ID=
NEXT_PUBLIC_API_BASE_URL=        # public URL of the backend only; nothing secret in NEXT_PUBLIC_* / VITE_*

# ---------- Monday.com (optional) -------------------------------------
MONDAY_API_TOKEN=                # personal API token (verify)
MONDAY_BOARD_ID=

# ---------- Miro (optional) -------------------------------------------
MIRO_ACCESS_TOKEN=               # from a Miro developer app with board scopes (verify)
MIRO_BOARD_ID=

# ---------- Telegram (only if you choose the generic exercise) --------
TELEGRAM_BOT_TOKEN=              # from @BotFather; synthetic project info only
TELEGRAM_CHAT_ID=

# ---------- Observability ---------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=     # local collector, empty = console
LOG_LEVEL=INFO

# ---------- Feature flags ---------------------------------------------
FEATURE_LIVE_AI=false
FEATURE_ADJUSTMENT_EXECUTION=true
FEATURE_PROTOCOL_LABS=false

# ---------- No keys needed (you log in once yourself) -----------------
# bolt.new   : browser login; export code via its GitHub/download option
# Cursor     : desktop app login
# Egolite    : desktop app (macOS); verify product first
# Invoco     : desktop app (macOS); verify product first
# Mira       : verify exact product first
# Claude Code: already logged in (you're using it)
